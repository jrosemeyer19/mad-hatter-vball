# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=volleyball_tournament
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Server Configuration
PORT=5000
# Interface to bind to. Defaults to localhost so the API is only reachable
# through nginx. Use 0.0.0.0 only if something off-box must hit it directly.
HOST=localhost
NODE_ENV=production

# Default Super Admin (will be created on first run).
# Must satisfy the app's password policy: at least 9 characters including 3 of
# these 4 — uppercase letter, lowercase letter, number, symbol. init-db refuses
# to create the account otherwise. Change it after the first login.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=Change-Me-First1
